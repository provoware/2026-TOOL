{
  "agents": {
    "analysis": ".agents/ANALYSE_AGENT.md",
    "compliance": ".agents/PLAN_PRUEFER.md",
    "planning": ".agents/PLAN_AGENT.md"
  },
  "app": {
    "id": "provoware-headquarter",
    "name": "PROVOWARE HEADQUARTER",
    "status": "iteration-2-data-core",
    "version": "0.2.0"
  },
  "backup": {
    "branches": ["backup/previous-1", "backup/previous-2"],
    "database_verified_keep": 2,
    "keep_previous": 2,
    "strategy": "rotating-git-branches"
  },
  "data": {
    "archive_strategy": "logical-reversible",
    "backup_keep": 2,
    "busy_timeout_ms": 5000,
    "calendar_source": "todos",
    "engine": "sqlite3",
    "foreign_keys": true,
    "journal_mode": "WAL",
    "recovery": "verified-backup-with-quarantine",
    "schema_version": 1
  },
  "iteration": {
    "name": "Datenkern",
    "number": 2,
    "release": "0.2.0"
  },
  "quality": {
    "crash_recovery_tests": true,
    "manual_user_acceptance_required": false,
    "post_validation": true,
    "pre_validation": true,
    "regression_required": true,
    "release_gate": "scripts/validate_all.sh"
  },
  "runtime": {
    "bind": "127.0.0.1",
    "external_dependencies": [],
    "python_min": "3.10"
  },
  "schema_version": 1,
  "ui": {
    "areas": ["A","B","C","D","E","F","G","H","I","J","K","L","M","N"],
    "complexity_levels": ["laie","profi","experte"],
    "main_workspace": "N",
    "themes": ["carbon","violet","steel","nordic","terminal"]
  }
}
